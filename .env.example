# Copy to .env and fill in your keys. Never commit .env.
# Loaded by packages/cli (findEnvPath walks up from cwd, then repo root).

# OpenCode Zen API key for zen/* models (including free tier)
# Get one at https://opencode.ai/auth
OPENCODE_API_KEY=

# Default model for the agent
# VAJRA_MODEL=zen/mimo-v2.6-flash-free

# Copy to .env and fill in your keys. Never commit .env.
# See packages/server/src/index.ts for how this is loaded (dotenv, cwd/.env).

# OpenRouter API key for the agent loop (required)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model for the agent (default: z-ai/glm-5.2:free)
# Override per-session in the web UI.
VAJRA_MODEL=z-ai/glm-5.2:free

# Optional: server port (default 4820)
# PORT=4820

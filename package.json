{
  "name": "vajra-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "Vajra: confine a shell so an AI coding agent running inside it cannot go haywire",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codekalakaars/vajra.git"
  },
  "bugs": {
    "url": "https://github.com/codekalakaars/vajra/issues"
  },
  "scripts": {
    "build": "pnpm --filter @codekalakaars/vajra-native run build",
    "build:debug": "pnpm --filter @codekalakaars/vajra-native run build:debug",
    "test": "echo \"no root-level tests; use pnpm test:all\"",
    "test:rust": "cargo test --manifest-path packages/native/Cargo.toml",
    "lint": "cargo clippy --manifest-path packages/native/Cargo.toml --all-targets -- -D warnings",
    "dev": "turbo run dev --filter=@codekalakaars/vajra --filter=@codekalakaars/vajra-sandbox",
    "cli": "pnpm --filter @codekalakaars/vajra build && node packages/vajra/dist/cli/index.js",
    "dev:all": "pnpm -r --parallel dev",
    "build:all": "turbo run build",
    "test:all": "turbo run test"
  },
  "devDependencies": {
    "@codekalakaars/vajra-native": "workspace:*",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">= 18"
  }
}

{
  "name": "@codekalakaars/vajra-core",
  "version": "0.0.1",
  "description": "Linux native operations for Vajra",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codekalakaars/vajra.git"
  },
  "bugs": {
    "url": "https://github.com/codekalakaars/vajra/issues"
  },
  "napi": {
    "name": "vajra-core",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd packages/core",
    "build:debug": "napi build --platform --cargo-cwd packages/core",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "test": "node --test \"test/*.test.mjs\"",
    "test:rust": "cargo test --manifest-path packages/core/Cargo.toml",
    "lint": "cargo clippy --manifest-path packages/core/Cargo.toml --all-targets -- -D warnings",
    "dev": "turbo run dev --filter=@codekalakaars/vajra-cli --filter=@codekalakaars/vajra-protocol --filter=@codekalakaars/vajra-sandbox --filter=@codekalakaars/vajra-agent-core",
    "cli": "pnpm --filter @codekalakaars/vajra-cli build && node packages/cli/dist/index.js",
    "dev:all": "pnpm -r --parallel dev",
    "build:all": "turbo run build",
    "test:all": "turbo run test"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.14.0",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.9.0",
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">= 18"
  }
}

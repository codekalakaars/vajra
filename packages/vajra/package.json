{
  "name": "@codekalakaars/vajra",
  "version": "0.0.1",
  "description": "Confine a shell so an AI coding agent running inside it cannot go haywire",
  "type": "module",
  "bin": {
    "vajra": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@codekalakaars/vajra-sandbox": "workspace:*",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

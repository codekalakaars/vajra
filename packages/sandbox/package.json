{
  "name": "@codekalakaars/vajra-sandbox",
  "version": "0.0.1",
  "description": "File policy, secret masking and process guards for confining a shell",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codekalakaars/vajra.git"
  },

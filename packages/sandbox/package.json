{
  "name": "@vajra/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vajra": "dist/cli.js"
  },

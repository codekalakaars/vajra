{
  "name": "@codekalakaars/vajra-cli",
  "version": "0.0.1",
  "description": "Vajra CLI - Multi-agent task execution from the terminal",
  "type": "module",
  "bin": {
    "vajra": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent/developer": {
      "types": "./dist/agent/developer.d.ts",
      "default": "./dist/agent/developer.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codekalakaars/vajra-agent-core": "workspace:*",
    "@codekalakaars/vajra-core": "workspace:*",
    "@codekalakaars/vajra-protocol": "workspace:*",
    "@codekalakaars/vajra-sandbox": "workspace:*",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "ink": "^7.1.1",
    "marked": "^18.0.11",
    "marked-terminal": "^7.3.0",
    "openai": "^7.8.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

{
  "name": "@codekalakaars/vajra-cli",
  "version": "0.1.0",
  "description": "Vajra CLI - Multi-agent task execution from the terminal",
  "type": "module",
  "bin": {
    "vajra": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@codekalakaars/vajra-core": "workspace:*",
    "@codekalakaars/vajra-protocol": "workspace:*",
    "@codekalakaars/vajra-sandbox": "workspace:*",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

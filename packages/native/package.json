{
  "name": "@codekalakaars/vajra-native",
  "version": "0.0.1",
  "description": "Native (Rust, napi) Linux operations for Vajra: process control and Landlock confinement",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codekalakaars/vajra.git"
  },
  "bugs": {
    "url": "https://github.com/codekalakaars/vajra/issues"
  },
  "napi": {
    "name": "vajra-native",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release --cargo-cwd .",
    "build:debug": "napi build --platform --cargo-cwd .",
    "prepublishOnly": "napi prepublish -t npm",
    "universal": "napi universal",
    "test": "node --test \"test/*.test.mjs\""
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.14.0"
  },
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">= 18"
  }
}
